# Copy to .env and fill in your own key. Never commit the real .env.
#
#   cp .env.example .env
#
# Every agent in this project uses one model, gpt-6-luna, reached through
# Portkey with the OpenAI-compatible API. The key is read at runtime by
# backend/settings.py and is never hard-coded anywhere in the source.

PORTKEY_API_KEY=your-portkey-api-key-here
